# TrialGuard AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# MongoDB connection string (optional — app uses in-memory fallback if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB database name
MONGODB_DATABASE=trialguard

# Session signing secret — change this to a random string in any non-local environment
SESSION_SECRET=local-demo-session-secret-change-me

# Server bind address (default: 127.0.0.1)
APP_HOST=127.0.0.1

# Server port (default: 8000)
APP_PORT=8000

# Session lifetime in hours (default: 8)
SESSION_HOURS=8
